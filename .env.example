# Local single-node development. Copy this file to .env and replace every
# <generated-...> value with output from `npm run secrets:generate`.
NODE_ENV=development
HOST=127.0.0.1
PORT=7515
PUBLIC_BASE_URL=http://localhost:7515
JUMPGATE_TRUST_PROXY=0

JUMPGATE_DURABLE_DRIVER=sqlite
JUMPGATE_TTL_DRIVER=memory
JUMPGATE_SQLITE_PATH=.data/jumpgate.sqlite3

# Optional outside production. Defaults: fenced provider mutations, latest
# PostgreSQL migration, and Redis playback writer v4.
# JUMPGATE_PROVIDER_MUTATION_MODE=<legacy-or-fenced>
# JUMPGATE_POSTGRES_MIGRATION_CEILING=<exact-migration-version>
# JUMPGATE_REDIS_PLAYBACK_WRITE_VERSION=<3-or-4>
# JUMPGATE_REDIS_PLAYBACK_CLAIM_ROLLOUT_MODE=<transition-or-v6>
# JUMPGATE_SUBTITLE_S3_BUCKET=<dedicated-private-bucket>
# JUMPGATE_SUBTITLE_S3_REGION=auto
# JUMPGATE_SUBTITLE_S3_ENDPOINT=https://fly.storage.tigris.dev
# JUMPGATE_SUBTITLE_S3_FORCE_PATH_STYLE=0
# strict requires all S3 public-access-block flags plus a non-public policy.
# tigris-policy-status retains one permanent private one-byte canary per object-key generation.
# JUMPGATE_SUBTITLE_S3_PRIVACY_MODE=<strict-or-tigris-policy-status>
# Keep this blocked value until the live provider passes the exact-version purge attestation.
# JUMPGATE_SUBTITLE_PERMANENT_ERASURE_MODE=blocked-tigris-provider-confirmation-required
# JUMPGATE_SUBTITLE_S3_ACCESS_KEY_ID=<secret-manager-value>
# JUMPGATE_SUBTITLE_S3_SECRET_ACCESS_KEY=<secret-manager-value>
# JUMPGATE_SUBTITLE_OBJECT_KEY_CURRENT_ID=<stable-lowercase-key-id>
# JUMPGATE_SUBTITLE_OBJECT_KEY_KEYRING=<secret-manager-json-id-key-array>

# Generate these together. Keep the same values across restarts and backups.
CONFIG_SECRET=<generated-config-secret>
JUMPGATE_TOKEN_PEPPER=<generated-token-pepper>
JUMPGATE_ENVELOPE_PRIMARY_KEY_ID=<generated-primary-key-id>
JUMPGATE_ENVELOPE_KEYRING=<generated-envelope-keyring-json>

# Production requires TRAKT_CLIENT_SECRET; TRAKT_CLIENT_ID optionally overrides the built-in public client ID.
TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=<required-from-secret-manager>
# TMDB_API_KEY=<optional-from-secret-manager>

# Production requires HTTPS, shared PostgreSQL and Redis, and persistent security values.
# Supply every resolved value through the deployment platform's secret manager.
# NODE_ENV=production
# HOST=0.0.0.0
# PUBLIC_BASE_URL=https://bridge.example.com
# JUMPGATE_TRUST_PROXY=1
# JUMPGATE_DURABLE_DRIVER=postgres
# JUMPGATE_TTL_DRIVER=redis
# DATABASE_URL=<postgresql-connection-url>
# REDIS_URL=<redis-or-rediss-connection-url>
# JUMPGATE_PROVIDER_MUTATION_MODE=<legacy-or-fenced>
# JUMPGATE_POSTGRES_MIGRATION_CEILING=<exact-migration-version>
# JUMPGATE_REDIS_PLAYBACK_WRITE_VERSION=<3-or-4>
# JUMPGATE_REDIS_PLAYBACK_CLAIM_ROLLOUT_MODE=<transition-or-v6>
