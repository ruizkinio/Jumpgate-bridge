# Deny the build context by default. The image copies only these runtime inputs.
**
!package.json
!package-lock.json
!.npmrc
!index.js
!lib/
!lib/**
!migrations/
!migrations/**
!public/
!public/**

# Secrets and local configuration stay outside every local or remote build context.
.env
.env.*
**/.env
**/.env.*
**/*.key
**/*.pem
**/*.p12
**/*.pfx

# Version-control, CI, dependencies, tests, and reports are not runtime inputs.
.git
.git/**
.github
.github/**
node_modules
node_modules/**
test
test/**
tests
tests/**
**/__tests__/**
coverage
coverage/**
.nyc_output
.nyc_output/**

# Local state, databases, caches, and logs must never be baked into an image.
.data
.data/**
data
data/**
logs
logs/**
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*

# Android, IDE, build, and generated artifacts are non-runtime material.
android
android/**
**/.gradle/**
**/.idea/**
**/.vscode/**
**/build/**
**/dist/**
**/out/**
**/*.apk
**/*.aab
**/*.class
**/*.jar
